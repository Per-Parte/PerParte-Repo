{
  "name": "per-parte",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo inicial da Per Parte: site, configurador e design system.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "site": "npm run dev --workspace @perparte/site",
    "site:build": "npm run build --workspace @perparte/site",
    "site:check": "npm run check --workspace @perparte/site",
    "site:test": "node --test apps/site/tests/*.test.mjs",
    "emails:gerar": "node docs/emails/gerar-previas.mjs",
    "emails:preview": "node docs/emails/servir-previas.mjs",
    "emails:enviar": "node apps/site/emails/enviar.mjs",
    "quadro": "npm run dev --workspace @perparte/quadro",
    "tokens:gerar": "node packages/design-system/gerar.mjs",
    "tokens:verificar": "node packages/design-system/gerar.mjs --check",
    "configurador": "npm run dev --workspace @perparte/configurador",
    "configurador:build": "npm run build --workspace @perparte/configurador",
    "configurador:check": "npm run check --workspace @perparte/configurador",
    "configurador:test": "npm run test --workspace @perparte/configurador"
  }
}
