# Copie para .env.local e preencha com os valores do painel do Supabase
# (Settings → API Keys). A chave publishable é pública por design — vai ao
# navegador de todo visitante. Chaves secretas (sb_secret / service_role)
# NUNCA entram em variável NEXT_PUBLIC_ nem neste repositório.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
