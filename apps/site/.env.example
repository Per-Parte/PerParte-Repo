# Copie para apps/site/.env.local (ignorado pelo Git) e reinicie npm run site.
# Também aceita .env.local da raiz; variáveis do processo têm prioridade.
SHOPIFY_STORE_DOMAIN=cpegt6-2x.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Token da Storefront API, obtido no canal Headless. Nunca usar token Admin aqui.
# Preencha apenas UM dos tokens. O público basta e permanece no servidor.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Coleção publicada no MESMO canal do token. Vazio consulta o catálogo geral.
SHOPIFY_COLLECTION_HANDLE=todas

# Cole a URL de contas de cliente exibida em Configurações > Contas de cliente.
# Sem esse valor, o site informa que o acesso à conta ainda está em preparação.
SHOPIFY_CUSTOMER_ACCOUNT_URL=

# Origens públicas EXATAS autorizadas a alterar carrinho, separadas por vírgula.
# localhost/127.0.0.1 são aceitos para a porta em uso, sem cadastrar manualmente.
SITE_ORIGINS=https://perparte.com,https://www.perparte.com
PORT=4174
HOST=127.0.0.1

# Vercel usa api/index.mjs a partir da raiz do repo. Só hospedar dist não fornece API.
# Token privado atrás de proxy exige adaptar a captura de IP a um proxy confiável.
# O servidor ignora X-Forwarded-For enviado diretamente pelo navegador.

# E-mails transacionais: somente código interno e CLI; nenhuma rota pública/gatilho.
# Use chave Resend com permissão de envio para o domínio verificado, nunca no frontend.
RESEND_API_KEY=
RESEND_ENABLED=false
EMAIL_FROM="Per Parte <sistema@emails.perparte.com>"
EMAIL_REPLY_TO=davi@perparte.com
EMAIL_SITE_URL=https://perparte.com
EMAIL_ACCOUNT_URL=https://shopify.com/102503383338/account
# CLI gera prévia em .local/emails por padrão. Envio também exige --enviar.
# --evento é um ID opaco estável, sem e-mail/nome. Repetições mantêm dados/configuração.
# Resend retém idempotência por 24 h; não há fila ou registro durável de envios aqui.
